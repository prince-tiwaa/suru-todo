# ─────────────────────────────────────────────────────────────
# Suru AI configuration (all optional)
#
# With no key set, Suru runs in DEMO MODE: every AI feature still
# works using a built-in rules engine, and the UI shows a "Demo" badge.
# Keys are only read on the server (src/app/api/ai/route.ts) and are
# never sent to the browser. Never commit a real .env file.
# ─────────────────────────────────────────────────────────────

# Option A — Anthropic (preferred if both are set)
ANTHROPIC_API_KEY=

# Option B — OpenAI, or any OpenAI-compatible API (Groq, OpenRouter, Together, local Ollama…)
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: override the model. Defaults: claude-haiku-4-5 (Anthropic) / gpt-4o-mini (OpenAI)
# AI_MODEL=

# Optional: max AI requests per minute per IP (default 30)
# AI_RATE_LIMIT_PER_MINUTE=30

# Optional: force demo mode even if a key is present
# AI_DISABLED=true
